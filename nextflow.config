/*
================================================================================
                    ClinVar Nextflow Configuration File
================================================================================
*/

manifest {
    name            = 'clinvar-bioinformatics-pipeline'
    author          = 'Senior Bioinformatics Engineer & Data Scientist'
    homePage        = 'https://github.com/clinvar-bioinformatics-pipeline'
    description     = 'Publication-grade NCBI ClinVar variant analysis pipeline using Nextflow DSL2'
    mainScript      = 'main.nf'
    nextflowVersion = '>=21.04.0'
    version         = '1.0.0'
}

// Global default parameters
params {
    url         = "https://ftp.ncbi.nlm.nih.gov/pub/clinvar/tab_delimited/variant_summary.txt.gz"
    data_dir    = "${projectDir}/data"
    results_dir = "${projectDir}/results"
    figures_dir = "${projectDir}/figures"
    assembly    = "GRCh38"
    min_stars   = 1
    sample_rows = 0
}

// Process configuration
process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'
}

// Execution tracing and reporting
timeline {
    enabled = true
    file    = "${params.results_dir}/reports/timeline.html"
}
report {
    enabled = true
    file    = "${params.results_dir}/reports/report.html"
}
trace {
    enabled = true
    file    = "${params.results_dir}/reports/trace.txt"
}

// Execution Profiles
profiles {
    standard {
        process.executor = 'local'
    }
    
    docker {
        docker.enabled = true
        process.container = 'biocontainers/python:3.10'
    }
    
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/requirements.txt"
    }
}
